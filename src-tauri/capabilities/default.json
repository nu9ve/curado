    "allow-configure-audio",
    "allow-get-keyboard",
    "allow-save-keyboard",
    "allow-midi-ports",
    "allow-midi-connect",
    "allow-midi-learn",
    "allow-midi-remove",
    "allow-open-visuals",
    "allow-play-queue",
    "allow-stop-queue",
    "allow-get-theme",
    "allow-save-theme",
